#include <iostream>
using namespace std;

bool isPalindrome(string s){
    int i=0;
    int j=s.size()-1;
    while(i<j){
        if(s[i]==s[j]){
            i++;
            j--;
        }
        else{
            return false;
        }
    }
    return true;
}
int main() 
{
    cout<<isPalindrome("tplnolt");
    return 0;
}
