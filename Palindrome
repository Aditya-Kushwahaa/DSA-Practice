#include <iostream>
using namespace std;

void reverse(string s){
    cout<<"before "<<s<<endl;
    int i=0;
    int j=s.size()-1;
    while(i<j){
        swap(s[i],s[j]);
        i++;
        j--;
    }
     cout<<"after "<<s<<endl;
}
int main() 
{
    reverse("tplnolt");
    return 0;
}
