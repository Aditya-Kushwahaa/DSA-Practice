import string

def remove_punctuation(text: str) -> str:
    translator = str.maketrans("", "", string.punctuation)
    return text.translate(translator)


def main():
    sample_text = "Hello, Aditya! How are you?"

    print("Original Text:")
    print(sample_text)

    cleaned_text = remove_punctuation(sample_text)

    print("\nText after removing punctuation:")
    print(cleaned_text)

    user_text = input("\nEnter your own text to clean: ")
    print("Cleaned Text:", remove_punctuation(user_text))


if __name__ == "__main__":
    main()
