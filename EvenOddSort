print("Welcome!! This program sorts numbers into even and odd.")
print("Enter the numbers and I'll separate them for you!!")
numbers = []
print("Enter the number of terms:")
n = int(input())
for i in range(n):
    number = int(input(f"Enter number {i+1}: "))
    numbers.append(number)
print("Your numbers are:", numbers)
even = []
odd = []
for number in numbers:
    if number % 2 == 0:
        even.append(number)
        print(f"{number} is even")
    else:
        odd.append(number)
        print(f"{number} is odd")
print("--- RESULTS ---")
print("Even numbers:", even)
print("Odd numbers:", odd)
print("How many even numbers?")
print (len(even))
print("How many odd numbers?")
print (len(odd))
